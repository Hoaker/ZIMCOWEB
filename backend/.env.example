# Zimco Enterprise Backend Configuration Environment

# Server Settings
PORT=5000
NODE_ENV=development

# Database Settings (PostgreSQL Connection String or parameters)
# E.g. postgres://username:password@hostname:5432/databasename
DATABASE_URL=postgresql://postgres:your_secure_password@localhost:5432/zimco_cooperative

# Security Settings
# Make sure to set a cryptographically secure key in production (minimum 32 characters)
JWT_SECRET=super_secret_corporate_token_signing_key_for_zimco
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12

# Cors Whitelists (comma separated urls)
ALLOWED_ORIGINS=http://localhost:3000,https://your-frontend-domain.vercel.app
