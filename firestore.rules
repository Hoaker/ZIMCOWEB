rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny for unmatched documents
    match /{document=**} {
      allow read, write: if false;
    }

    // --- REUSABLE SECURITY HELPERS ---
    
    // Checks if the user is authenticated
    function isSignedIn() {
      return request.auth != null;
    }

    // Checks if document ID is valid string
    function isValidId(id) {
      return id is string && id.size() <= 128;
    }

    // --- COLLECTION RULES ---

    // 1. Email Mappings Collection (for login and ID lookups)
    match /emailToMember/{email} {
      allow read: if true;
      allow write: if true;
    }

    // 2. Users Profiles Collection (Cooperative Members & Administrators)
    match /users/{memberId} {
      allow read: if true;
      allow write: if true;

      // Subcollections under users (transactions, loginLogs, deductions, notifications, etc.)
      match /{allSubcollections=**} {
        allow read, write: if true;
      }
    }

    // 3. Staff & Administrative Officers Collection
    match /staff_members/{staffId} {
      allow read: if true;
      allow write: if true;

      match /{allSubcollections=**} {
        allow read, write: if true;
      }
    }
  }
}

